{
  "components": {
    "schemas": {
      "Health": {
        "description": "Liveness payload.\n\nAttributes:\n    status: Always `ok` when the process is serving.\n    version: The running `cvforge` package version.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CVForge"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Report that the process is serving, and which version is running.\n\nReturns:\n    The liveness payload.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
